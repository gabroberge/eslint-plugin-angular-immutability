{
	"name": "@gabroberge/eslint-plugin-angular-immutability",
	"version": "0.0.11",
	"private": false,
	"description": "ESLint plugin for Angular Immutability",
	"keywords": [
		"angular",
		"eslint",
		"immutability",
		"readonly",
		"typescript"
	],
	"homepage": "https://github.com/gabroberge/eslint-plugin-angular-immutability#readme",
	"bugs": "https://github.com/gabroberge/eslint-plugin-angular-immutability/issues",
	"license": "MIT",
	"author": "Gabriel Roberge",
	"repository": {
		"type": "git",
		"url": "https://github.com/gabroberge/eslint-plugin-angular-immutability.git"
	},
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"lint": "eslint \"src/**/*.ts\"",
		"test": "vitest run"
	},
	"dependencies": {
		"@typescript-eslint/types": "^8.68.0",
		"@typescript-eslint/utils": "^8.68.0"
	},
	"devDependencies": {
		"eslint": "^10.9.1"
	},
	"peerDependencies": {
		"eslint": ">=10"
	}
}
