{
	"name": "eslint-plugin-angular-immutability",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "turbo run lint",
		"prepare": "husky",
		"start:dev": "turbo run start:dev",
		"test": "turbo run test",
		"typecheck": "tsc -b tsconfig.build.json"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.2",
		"@vitest/coverage-v8": "^5.0.1",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.11.0",
		"eslint-plugin-perfectionist": "^5.11.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.5.1",
		"oxfmt": "^0.68.0",
		"tsc-files": "^1.1.4",
		"tsdown": "^0.23.0",
		"turbo": "^2.11.2",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.13",
			"onFail": "ignore"
		}
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "bun@1.4.2"
}
