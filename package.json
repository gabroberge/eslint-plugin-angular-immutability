{
	"name": "eslint-plugin-angular-immutability",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "turbo run lint",
		"prepare": "husky",
		"start:dev": "turbo run start:dev",
		"test": "turbo run test",
		"typecheck": "tsc -b tsconfig.build.json"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.9.1",
		"eslint-plugin-perfectionist": "^5.10.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.4.1",
		"oxfmt": "^0.65.0",
		"tsc-files": "^1.1.4",
		"tsdown": "^0.22.14",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vitest": "^4.1.11"
	},
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.3.13",
			"onFail": "ignore"
		}
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "bun@1.3.13"
}
